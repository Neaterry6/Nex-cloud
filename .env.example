# ── Supabase (required) ──────────────────────────────────────────────
# Get these from: Supabase Dashboard → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Server-only. NEVER expose to the browser. Used by server actions for
# signed URLs and privileged operations. Leave blank in local dev only if
# you use Edge Functions for those paths.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ── Resend (optional — email notifications) ──────────────────────────
# If unset, the app runs fully; in-app notifications keep working and the
# admin panel shows "Email not configured". Create key at resend.com.
RESEND_API_KEY=
RESEND_FROM_EMAIL=Nex Cloud <notifications@yourdomain.com>
RESEND_FROM_NAME=Nex Cloud

# ── App ──────────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase Edge Function verification (shared secret between Next.js
# server actions and Edge Functions — server-only).
EDGE_FUNCTION_SECRET=generate-a-long-random-string
